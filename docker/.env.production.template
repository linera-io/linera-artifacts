# Production deployment environment variables
#
# Normally written for you by scripts/deploy-validator.sh, which fills in
# DOMAIN, ACME_EMAIL, GENESIS_URL, GENESIS_BUCKET, GENESIS_PATH_PREFIX,
# VALIDATOR_KEY, VALIDATOR_NAME, HOSTNAME, LINERA_IMAGE and NUM_SHARDS.
# See https://docs.infra.linera.net/QUICKSTART/. This template is the
# reference for manual setup and for tuning an existing deployment.
#
# WHAT YOU ACTUALLY HAVE TO PROVIDE
#
#   Two variables — DOMAIN and ACME_EMAIL, immediately below. Caddy needs
#   them to obtain the Let's Encrypt certificate; without a valid
#   certificate the validator is not reachable by the rest of the network.
#
#   Two files — server.json (your signing key) and genesis.json, both in
#   this directory. The directory is bind-mounted at /config, so the
#   containers read them straight off disk; they are not passed through
#   this file.
#
# Everything else is optional. Apart from HOSTNAME, which is only a
# metrics label, every remaining variable is commented out and the value
# shown next to it is the default the stack already uses, so uncomment a
# line only when you want to change it. In particular the storage/cache
# and ScyllaDB commitlog defaults are the values the testnet-conway
# validators run in production — leave them as they are unless you are on
# a small or low-RAM box.

# Domain configuration (required)
DOMAIN=your-domain.example.com
ACME_EMAIL=admin@example.com

# Deployment record — written by deploy-validator.sh, read by no container.
# GENESIS_URL and GENESIS_BUCKET/GENESIS_PATH_PREFIX tell *the script* where
# to fetch genesis.json from; once it is on disk the stack only ever reads
# ./genesis.json. VALIDATOR_KEY / VALIDATOR_NAME are recorded for your
# reference — the signing key the validator actually uses is ./server.json.
# Editing anything in this block does not change what runs.
#GENESIS_URL=https://storage.googleapis.com/linera-io-dev-public/testnet-conway/genesis.json
#GENESIS_BUCKET=https://storage.googleapis.com/linera-io-dev-public
#GENESIS_PATH_PREFIX=testnet-conway
#VALIDATOR_KEY=
#VALIDATOR_NAME=

# Storage configuration
#STORAGE_REPLICATION_FACTOR=1

# Docker images (uncomment to override defaults)
#LINERA_IMAGE=us-docker.pkg.dev/linera-io-dev/linera-public-registry/linera:testnet_conway_release
#SCYLLA_IMAGE=scylladb/scylla:6.2.3
#CADDY_IMAGE=caddy:2.10.2-alpine
#WATCHTOWER_IMAGE=nickfedor/watchtower:1.15.0

# Hostname identifier for this validator, used as a metrics/logs label.
# Only read by the observability overlays (docker-compose.alloy.yml and
# docker-compose.local-monitoring.yml); the core stack ignores it.
HOSTNAME=your-domain.example.com

# Data directories (bind-mounted into the containers). Keep ScyllaDB on
# its fastest disk if you have a dedicated one. Each service uses its
# own directory so you can back them up (or skip the unimportant ones)
# with your normal file-level tooling.
#SCYLLA_DATA_DIR=./data/scylla
#CADDY_DATA_DIR=./data/caddy-data
#CADDY_CONFIG_DIR=./data/caddy-config
# Only used by the docker-compose.local-monitoring.yml overlay:
#PROMETHEUS_DATA_DIR=./data/prometheus
#PROMETHEUS_RETENTION=15d
#GRAFANA_DATA_DIR=./data/grafana
#GRAFANA_ADMIN_PASSWORD=admin
# Only used by the docker-compose.alloy.yml overlay:
#ALLOY_IMAGE=grafana/alloy:v1.5.0

# Port configuration
#WEB_HTTP_PORT=80
#WEB_HTTPS_PORT=443
#PROXY_PORT=19100
#SCYLLA_PORT=9042

# ScyllaDB tuning
# developer-mode=0 is recommended for production, =1 disables safety checks (testing only)
#SCYLLA_DEVELOPER_MODE=0
# overprovisioned=1 tells ScyllaDB it shares the machine with other services.
# On a DEDICATED box (Scylla owns the machine), set this to 0 and pin Scylla
# to its own cores via SCYLLA_CPUSET below for GKE-class isolation. The GKE
# validators give Scylla dedicated nodes with perftune CPU pinning + IRQ
# steering — the single-host path can approximate that but cannot fully match
# it (Scylla shares the kernel/NICs with the shards and proxy here).
#SCYLLA_OVERPROVISIONED=1
# Optional CPU pinning for ScyllaDB on dedicated hardware. When set, Scylla is
# restricted to these logical CPUs (Docker --cpuset-cpus) so it never contends
# with the shards/proxy for CPU. Leave UNSET for the shared-host case.
# ALWAYS set WORKLOAD_CPUSET to the complementary set at the same time: it
# pins every other service (shards, proxy, Caddy, Watchtower) off ScyllaDB's
# cores. SCYLLA_CPUSET alone confines ScyllaDB but does not protect it — the
# kernel can still schedule the shards onto its cores.
# Both take LOGICAL CPU numbers. Check `lscpu -e` first: on SMT machines two
# logical CPUs share each physical core, and on chiplet CPUs (AMD CCDs) each
# die has its own L3 — align the split to a die boundary so ScyllaDB keeps a
# private L3. See "Choosing which cores to pin" in docs/DOCKER-COMPOSE.md.
# Example for a 16-core/32-thread AMD box (lscpu: CPUs 0-15 = die 0,
# CPUs 16-31 = die 1, adjacent SMT siblings):
#   SCYLLA_CPUSET=0-15        # ScyllaDB owns die 0 (private L3)
#   WORKLOAD_CPUSET=18-31     # everything else on die 1; 16-17 left free
#                             # for the OS and network IRQs
#   SCYLLA_OVERPROVISIONED=0
#   LIMIT_CPUS_SCYLLA=16      # match the cpuset size (drives --smp)
#   LIMIT_MEM_SCYLLA=51G      # keep >= ~1.2 GiB per Scylla shard
#SCYLLA_CPUSET=
#WORKLOAD_CPUSET=
# Commitlog durability. Defaults match the testnet-conway GKE validators:
# batch sync with a 2 ms window (writes are fsynced before being acked).
# Set SCYLLA_COMMITLOG_SYNC=periodic to trade durability for throughput.
#SCYLLA_COMMITLOG_SYNC=batch
#SCYLLA_COMMITLOG_SYNC_BATCH_WINDOW_MS=2
# Healthcheck tuning (increase start_period on slow machines)
#SCYLLA_HEALTHCHECK_INTERVAL=10s
#SCYLLA_HEALTHCHECK_TIMEOUT=10s
#SCYLLA_HEALTHCHECK_RETRIES=20
#SCYLLA_HEALTHCHECK_START_PERIOD=60s

# Watchtower auto-update interval (seconds)
#WATCHTOWER_INTERVAL=30

# Observability - Prometheus metrics push (OTLP format)
#PROMETHEUS_OTLP_URL=https://your-prometheus-endpoint/otlp
#PROMETHEUS_OTLP_USER=
#PROMETHEUS_OTLP_PASS=

# Observability - Loki logs push
#LOKI_PUSH_URL=https://your-loki-endpoint/loki/api/v1/push
#LOKI_PUSH_USER=
#LOKI_PUSH_PASS=

# Observability - Tempo traces push
#TEMPO_OTLP_URL=https://your-tempo-endpoint/tempo/otlp
#TEMPO_OTLP_USER=
#TEMPO_OTLP_PASS=

# File descriptor limits (ulimit nofile)
# Sets soft and hard limit for all Linera services. Helps prevent DNS resolution
# failures and connection exhaustion under high load. Default: 524288 (512K).
#ULIMIT_NOFILE=524288

# Resource limits (adjust based on host machine specs)
# Defaults are tuned for a dedicated 16-core / 64GB RAM machine.
# Uncomment and modify to override defaults.

# Web (Caddy reverse proxy)
#LIMIT_CPUS_WEB=1.00
#LIMIT_MEM_WEB=3G

# ScyllaDB
# LIMIT_CPUS_SCYLLA also controls ScyllaDB's shard count (--smp).
# This value can only INCREASE after first start. Reducing it requires a full
# data wipe (delete the linera-scylla-data volume and re-sync from genesis).
# LIMIT_MEM_SCYLLA is the cgroup memory limit. ScyllaDB reads it directly
# and reserves its own headroom for OS buffers — DO NOT pass --memory
# explicitly (we don't, in the compose). To grow Scylla, just raise
# LIMIT_MEM_SCYLLA — the cgroup is the single source of truth.
#LIMIT_CPUS_SCYLLA=4.00
#LIMIT_MEM_SCYLLA=30G
# SCYLLA_SMP overrides the shard count independently of LIMIT_CPUS_SCYLLA.
# Rarely needed.
#SCYLLA_SMP=4

# Linera proxy
#LIMIT_CPUS_PROXY=1.50
#LIMIT_MEM_PROXY=4G

# Linera shards (per-shard limits for fine-grained tuning)
# Each shard can be configured independently. Useful when some shards handle
# more chains than others due to hash distribution.
#LIMIT_CPUS_SHARD_0=2.00
#LIMIT_MEM_SHARD_0=6G
#LIMIT_CPUS_SHARD_1=2.00
#LIMIT_MEM_SHARD_1=6G
#LIMIT_CPUS_SHARD_2=2.00
#LIMIT_MEM_SHARD_2=6G
#LIMIT_CPUS_SHARD_3=2.00
#LIMIT_MEM_SHARD_3=6G

# Observability stack
#LIMIT_CPUS_ALLOY=0.50
#LIMIT_MEM_ALLOY=1G
#LIMIT_CPUS_PROMETHEUS=0.50
#LIMIT_MEM_PROMETHEUS=512M
#LIMIT_CPUS_GRAFANA=0.50
#LIMIT_MEM_GRAFANA=512M

# Watchtower
#LIMIT_CPUS_WATCHTOWER=0.25
#LIMIT_MEM_WATCHTOWER=256M

# =============================================================================
# Storage & in-memory cache tuning
# =============================================================================
# Defaults below match the testnet-conway GKE validators
# (helm/linera-validator/values.yaml: shards.cli / proxies.cli). On a big
# enough box the single-host stack can be tuned toward GKE-class performance
# by leaving these at the GKE values. Lower them only on small/low-RAM boxes.
#
# Storage (LRU) caches — applied to BOTH shards and the proxy. Sizes in
# bytes / entry counts / per-entry byte limits.
#LINERA_STORAGE_MAX_CACHE_SIZE=1000000000
#LINERA_STORAGE_MAX_CACHE_ENTRIES=500000
#LINERA_STORAGE_MAX_VALUE_ENTRY_SIZE=1000000
#LINERA_STORAGE_MAX_FIND_KEYS_ENTRY_SIZE=1000000
#LINERA_STORAGE_MAX_FIND_KEY_VALUES_ENTRY_SIZE=1000000
#LINERA_STORAGE_MAX_CACHE_VALUE_SIZE=500000000
#LINERA_STORAGE_MAX_CACHE_FIND_KEYS_SIZE=200000000
#LINERA_STORAGE_MAX_CACHE_FIND_KEY_VALUES_SIZE=10000000

# In-memory caches (entry counts) — applied to BOTH shards and the proxy.
#LINERA_BLOB_CACHE_SIZE=1000
#LINERA_CONFIRMED_BLOCK_CACHE_SIZE=10000
#LINERA_CERTIFICATE_CACHE_SIZE=5000
#LINERA_CERTIFICATE_RAW_CACHE_SIZE=50000
#LINERA_EVENT_CACHE_SIZE=20000

# Shard-only in-memory caches (entry counts). The proxy does not execute
# blocks, so these apply to shards only.
# Each execution-state entry can use 10-500 KB, each block entry 1 KB-1 MB.
# These now default to the GKE values (20000/20000). Lower them on a
# small/low-RAM box to save RAM at the cost of read performance.
#LINERA_BLOCK_CACHE_SIZE=20000
#LINERA_EXECUTION_STATE_CACHE_SIZE=20000

# Chain-worker keep-alive TTL (ms): how long an idle loaded chain worker is
# kept resident before being dropped. Shard-only. Matches GKE.
#LINERA_CHAIN_WORKER_TTL_MS=300000
